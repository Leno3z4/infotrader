# Gemini roles. Use credentials/projects you legitimately control.
# Role maps are comma-separated environment variable names.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_RESEARCH_KEYS=GEMINI_API_KEY_1,GEMINI_API_KEY_4
GEMINI_DECISION_KEYS=GEMINI_API_KEY_2,GEMINI_API_KEY_5
GEMINI_CHAT_KEYS=GEMINI_API_KEY_3,GEMINI_API_KEY_1
GEMINI_MODEL=gemini-3.8-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTROL_TOKEN=

# Shared persistent state directory (Docker volume on OCI)
STATE_DIR=/app/state

# Meme/news/NFT monitor
MIN_LIQUIDITY_USD=5000
NEWS_LIQUIDITY_USD=2500
WATCH_TOKENS=
NFT_COLLECTIONS=
OPENSEA_API_KEY=

# Polymarket discovery
MAX_MARKETS_PER_RUN=8
POLYMARKET_PROFILE_ADDRESS=

# Risk gates
MAX_POSITION_USD=5
MAX_DAILY_LOSS_USD=15
MAX_TRADES_PER_DAY=5
MIN_CONFIDENCE=0.65

# Dry-run is mandatory until a separately verified live executor is installed.
DRY_RUN=true
TRADING_STATE_FILE=/app/state/daily_state.json
KILL_SWITCH_FILE=/app/state/STOP
