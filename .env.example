# Gemini failover. Use explicitly configured keys/projects; multiple keys in one
# Google Cloud project do not multiply that project's quota.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_MODEL=gemini-2.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meme/news/NFT monitor
MIN_LIQUIDITY_USD=5000
NEWS_LIQUIDITY_USD=2500
WATCH_TOKENS=
NFT_COLLECTIONS=
RESERVOIR_API_KEY=

# Polymarket analyst
POLYMARKET_KEYWORD=
MAX_MARKETS_PER_RUN=5
POLYMARKET_PROFILE_ADDRESS=

# Risk gates
MAX_POSITION_USD=5
MAX_DAILY_LOSS_USD=15
MAX_TRADES_PER_DAY=5
MIN_CONFIDENCE=0.65

# Dry-run is mandatory in this release.
DRY_RUN=true
TRADING_STATE_FILE=polymarket_trader/daily_state.json
KILL_SWITCH_FILE=polymarket_trader/STOP
