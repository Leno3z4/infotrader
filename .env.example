# Gemini roles. Use credentials/projects you legitimately control.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_RESEARCH_KEYS=GEMINI_API_KEY_1,GEMINI_API_KEY_2
GEMINI_DECISION_KEYS=GEMINI_API_KEY_3,GEMINI_API_KEY_4
GEMINI_EXECUTION_KEYS=GEMINI_API_KEY_5
GEMINI_CHAT_KEYS=GEMINI_API_KEY_1,GEMINI_API_KEY_2
GEMINI_MODEL=gemini-3.8-flash

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTROL_TOKEN=

# Shared persistent state directory (Docker volume on OCI)
STATE_DIR=/app/state

# Meme/news/NFT monitor
MIN_LIQUIDITY_USD=5000
NEWS_LIQUIDITY_USD=2500
WATCH_TOKENS=
NFT_COLLECTIONS=
OPENSEA_API_KEY=

# Polymarket discovery
MAX_MARKETS_PER_RUN=8
POLYMARKET_PROFILE_ADDRESS=

# Polymarket risk gates
MAX_POSITION_USD=5
MAX_DAILY_LOSS_USD=15
MAX_TRADES_PER_DAY=5
MIN_CONFIDENCE=0.65
POLYMARKET_MAX_ORDER_USD=5
POLYMARKET_MIN_EDGE=0.05
POLYMARKET_MIN_CONFIDENCE=0.65
POLYMARKET_MIN_ENTRY_PRICE=0.05
POLYMARKET_MAX_ENTRY_PRICE=0.95

# Python Worker -> separate JavaScript execution Worker
# The private key belongs ONLY in the JavaScript executor Worker.
POLYMARKET_LIVE_TRADING=false
POLYMARKET_EXECUTOR_URL=
POLYMARKET_EXECUTOR_TOKEN=

# JavaScript executor Worker secrets/vars
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_WALLET_ADDRESS=
# POLYMARKET_FUNDER_ADDRESS=
# POLYMARKET_SIGNATURE_TYPE=0
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Dry-run remains the safe default.
DRY_RUN=true
TRADING_STATE_FILE=/app/state/daily_state.json
KILL_SWITCH_FILE=/app/state/STOP
